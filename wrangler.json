
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robux-store",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robux-store-db",
      "database_id": "GANTI_DENGAN_DATABASE_ID_D1"
    }
  ]
}
