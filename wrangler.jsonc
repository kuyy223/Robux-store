
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "robux-store",
  "main": "worker.js",
  "compatibility_date": "2026-10-11",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "robux-store-db-v2",
      "database_id": "3faebab1-908e-495c-9fc0-87cf0ddff967"
    }
  ]
}
